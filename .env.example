# LinkedIn credentials for auto-login (recommended)
LI_EMAIL=your_linkedin_email@example.com
LI_PASSWORD=your_linkedin_password

# LinkedIn session cookies (optional — used as fallback)
LI_AT=
JSESSIONID=

# API keys for authenticating requests to this service
API_KEYS=your-api-key-1,your-api-key-2

# Optional settings
CACHE_TTL=1800
RATE_LIMIT=10
